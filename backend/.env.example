# 1. CONEXIÓN A BASE DE DATOS NEON TECH (PostgreSQL):
# Copia la cadena de conexión de tu proyecto en https://console.neon.tech
# Formato: postgresql://<usuario>:<password>@<host-neon>.tech/<database>?sslmode=require
DATABASE_URL=postgresql://usuario_neon:tu_password_aqui@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# (Opcional) Si quieres probar localmente antes de conectar Neon:
# DATABASE_URL=sqlite:///./dulce_delicia.db

# 2. SEGURIDAD Y JWT (JSON Web Tokens):
SECRET_KEY=dulce_delicia_reposteria_secreta_jwt_key_2026_super_segura
